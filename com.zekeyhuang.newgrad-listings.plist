<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.zekeyhuang.newgrad-listings</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/zekeyhuang/code/newgrad-watch/refresh-listings.sh</string>
    </array>

    <!-- Every 30 minutes, matching how often upstream commits the file. -->
    <key>StartInterval</key>
    <integer>1800</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/newgrad-listings.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/newgrad-listings.log</string>
</dict>
</plist>
